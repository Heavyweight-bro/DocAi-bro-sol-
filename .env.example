# Copy to .env.local. Environment keys override keys saved through local Settings.
# API keys are server-only; never use the VITE_ prefix.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: explicit primary provider (openai, gemini, anthropic).
# Otherwise the first configured provider is selected.
# AI_PROVIDER=gemini
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.1-pro-preview
ANTHROPIC_MODEL=claude-sonnet-4-6
COMPANY_NAME=Doc.AI

# Development: optional; otherwise .data/docai.json stores templates/results.
# Production: configure a server-only key with the necessary DB access.
SUPABASE_URL=
SUPABASE_KEY=
PORT=3000
# Development binds to localhost. Production defaults to 0.0.0.0.
# HOST=127.0.0.1
# APP_ORIGIN=https://docs.company.example
# LOCAL_DATA_PATH=.data/docai.json
# LOCAL_SETTINGS_DIR=.data/settings
