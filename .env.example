# Copy to .env.local. Environment keys override keys saved through local Settings.
# API keys are server-only; never use the VITE_ prefix.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Azure OpenAI (endpoint + key + deployment name as model)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Azure Claude via AI Foundry (Anthropic-compatible)
# AZURE_CLAUDE_API_KEY=
# AZURE_CLAUDE_ENDPOINT=https://my-resource.services.ai.azure.com
# AZURE_CLAUDE_MODEL=claude-sonnet-4-5
# Optional: explicit primary provider (openai, gemini, anthropic, azure_openai, azure_claude).
# Otherwise the first configured provider is selected.
# AI_PROVIDER=gemini
OPENAI_MODEL=gpt-5.6-luna
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-sonnet-5
COMPANY_NAME=Doc.AI

# Integration key for CRM/scripts (Bearer). UI on same origin does not need it.
# Generate a long random value, e.g. dok_… (min 16 chars). Comma-separated for several keys.
# DOCAI_INTEGRATION_KEY=
# DOCAI_INTEGRATION_KEYS=
# DOCAI_RATE_LIMIT_PER_MIN=60

# Stable workspace id (fork-ready; default "default")
# DOCAI_WORKSPACE_ID=default

# --- Users & sessions ---
# Development: without users the app is open only from this computer (loopback).
#   Create the first admin: npm run user -- add you@company.ua admin
# Production: users come from the environment (JSON array). Get a hash: npm run user -- hash you@company.ua admin
# DOCAI_USERS=[{"email":"you@company.ua","role":"admin","name":"Ім'я","passwordHash":"scrypt$..."}]
# Roles: viewer (read), operator (process/edit/approve), admin (templates, settings, users, audit).
# Required in production, >= 32 random characters (e.g. openssl rand -hex 32):
# DOCAI_SESSION_SECRET=
# DOCAI_SESSION_TTL_MIN=720
# Only for a trusted internal network served over plain http:
# DOCAI_COOKIE_SECURE=false
# Behind a reverse proxy (correct client IP for rate limits / https detection):
# TRUST_PROXY=1

# Async queue worker (in-process). Set DOCAI_WORKER=0 to disable.
# DOCAI_WORKER=1
# DOCAI_WORKER_INTERVAL_MS=1500
# DOCAI_JOB_MAX_ATTEMPTS=3
# LOCAL_JOBS_PATH=.data/jobs.json
# A job stuck in "processing" longer than this is re-queued (ms):
# DOCAI_JOB_LEASE_MS=600000
# Delete archived originals older than N days (0/empty = keep):
# DOCAI_FILE_RETENTION_DAYS=0

# Model escalation: if the default model's result fails the template schema (or the call fails),
# the document is re-read once by a stronger model of the same provider. Empty = off.
# OPENAI_ESCALATION_MODEL=gpt-4.1
# GEMINI_ESCALATION_MODEL=gemini-2.5-pro
# ANTHROPIC_ESCALATION_MODEL=claude-sonnet-5
# Exact prices for cost estimates (USD per 1M tokens), e.g. for new models:
# DOCAI_MODEL_PRICES={"gpt-5.6-luna":{"inputPerM":0.2,"outputPerM":0.8}}

# Queue backend: Postgres tables when Supabase is configured (multi-worker), else a local file.
# Force the file queue: DOCAI_QUEUE=file. Separate worker process: npm run worker (+ DOCAI_WORKER=0 on the web node).
# Serverless (Vercel): call /api/internal/worker-tick on a schedule with this secret (Vercel Cron uses CRON_SECRET):
# DOCAI_CRON_SECRET=

# Webhooks for CRM: outbox with retries; X-DocAI-Signature-256 (t=..,v1=HMAC of "t.body") + legacy X-DocAI-Signature
# DOCAI_WEBHOOK_URL=https://crm.example/hooks/docai
# DOCAI_WEBHOOK_SECRET=whsec_change_me

# Development: optional; otherwise .data/docai.json stores templates/results.
# Production: configure a server-only key with the necessary DB access.
SUPABASE_URL=
SUPABASE_KEY=
# Optional private Storage bucket for original files (create in Supabase first).
# SUPABASE_STORAGE_BUCKET=documents
PORT=3000
# Development binds to localhost. Production defaults to 0.0.0.0.
# HOST=127.0.0.1
# APP_ORIGIN=https://docs.company.example
# LOCAL_DATA_PATH=.data/docai.json
# LOCAL_SETTINGS_DIR=.data/settings
# LOCAL_FILES_DIR=.data/files
