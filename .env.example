# Copy to .env.local. Restart the server after changing these values.
# AI keys are server-only; never prefix them with VITE_.
GEMINI_API_KEY=
# Optional fallback when Gemini fails.
OPENAI_API_KEY=

# Optional in local development: without these, templates/history use .data/docai.json.
# Required for persistent storage in production / Vercel.
SUPABASE_URL=
SUPABASE_KEY=

PORT=3000
# Optional local development data path
# LOCAL_DATA_PATH=.data/docai.json
